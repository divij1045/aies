Implement a problem solver using the A* algorithm to solve the 8-puzzle problem.
import heapq

def h(s, goal):
    d = 0
    for i in range(9):
        if s[i] != 0:
            j = goal.index(s[i])
            d += abs(i//3 - j//3) + abs(i%3 - j%3)
    return d

def astar(start, goal):
    q = [(h(start, goal), 0, start)]
    cost = {tuple(start): 0}
    parent = {}

    while q:
        f, g, s = heapq.heappop(q)
        s = tuple(s)

        if g != cost[s]:
            continue

        if list(s) == goal:
            path = [s]
            while s in parent:
                s = parent[s]
                path.append(s)
            for state in reversed(path):
                print(state[:3])
                print(state[3:6])
                print(state[6:])
                print()
            print("Minimum moves:", len(path) - 1)
            return

        z = s.index(0)
        for p in (z-3, z+3, z-1, z+1):
            if 0 <= p < 9 and not (
                abs(p-z) == 1 and p//3 != z//3
            ):
                t = list(s)
                t[z], t[p] = t[p], t[z]
                t = tuple(t)
                ng = g + 1

                if ng < cost.get(t, float('inf')):
                    cost[t] = ng
                    parent[t] = s
                    heapq.heappush(q, (ng + h(t, goal), ng, t))

    print("No solution found")

start = list(map(int, input("Enter initial state: ").split()))
goal = list(map(int, input("Enter goal state: ").split()))

if sorted(start) != list(range(9)) or sorted(goal) != list(range(9)):
    print("Enter numbers 0 to 8 exactly once in each state")
else:
    astar(start, goal)

Implement a local search algorithm for solving travelling salesman problem (TSP). (hill climbing)

n = int(input("Enter cities: "))
d = [list(map(int, input().split())) for i in range(n)]
def dist(p):
return sum(d[p[i]][p[(i+1)%n]] for i in range(n))
path = list(range(n))
while True:
best = path[:]
for i in range(1, n):
for j in range(i+1, n):
new = path[:]
new[i], new[j] = new[j], new[i]
if dist(new) < dist(best):
best = new
if dist(best) >= dist(path):
break
path = best
print("Path:", path + [path[0]])
print("Distance:", dist(path))

