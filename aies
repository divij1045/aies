Develop a constraint satisfaction problem CSP solver for map coloring.
colors = ["Red", "Green", "Blue"]
map = {
    "A": ["B", "C"],
    "B": ["A", "C"],
    "C": ["A", "B"]
}

color = {}

def solve(region):
    if region == len(map):
        return True

    place = list(map.keys())[region]

    for c in colors:
        if all(color.get(n) != c for n in map[place]):
            color[place] = c

            if solve(region + 1):
                return True

            del color[place]

    return False

if solve(0):
    print(color)
else:
    print("No solution")

Implement gameplay with adversarial search using the minimax algorithm, example Tic-Tac-Toe or Chess.
b = [" "] * 9
def win(p):
    lines = [(0,1,2),(3,4,5),(6,7,8),
             (0,3,6),(1,4,7),(2,5,8),
             (0,4,8),(2,4,6)]
    return any(b[a] == b[c] == b[d] == p for a,c,d in lines)
def minimax(p):
    if win("O"): return 1
    if win("X"): return -1
    if " " not in b: return 0
    scores = []
    for i in range(9):
        if b[i] == " ":
            b[i] = p
            scores.append(minimax("X" if p == "O" else "O"))
            b[i] = " "
    return max(scores) if p == "O" else min(scores)
while True:
    print(b[:3], "\n", b[3:6], "\n", b[6:])
